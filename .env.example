# Copy to .env (gitignored). Every line is optional: the defaults in compose.yaml work for `docker compose --profile db up`.
# IMAGE_TAG=local
# WEB_PORT=8230
# POSTGRES_USER=suwstockdrill
# POSTGRES_PASSWORD=suwstockdrill
# POSTGRES_DB=suwstockdrill
# An external PostgreSQL: set this and start without the db profile (docker compose up -d).
# ConnectionStrings__Default=Host=db.example.internal;Port=5432;Database=suwstockdrill;Username=suwstockdrill;Password=change-me
# API_UPSTREAM=http://server:6340
